e\">\n<img src=\"images/c-klein-21-monolithe-arbres-morts.jpg\"\nalt=\"Le monolithe - Arbres morts - Odyssée, Charles Klein\"\n>\n<div\n    class=\"caption\"\n    data-fr=\"Le monolithe\"\n    data-en=\"The monolith\">\n </div>\n</section>\n\n<!-- =========================\n     PHOTOGRAPHIE S22\n========================= -->\n<section class=\"photo-page page\">\n<img src=\"images/c-klein-22-monolithe-dolmen-lune.jpg\"\nalt=\"Le monolithe - Dolmen avec lune - Odyssée, Charles Klein\"\n>\n<div\n    class=\"caption\"\n    data-fr=\"Le monolithe\"\n    data-en=\"The monolith\">\n </div>\n</section>\n\n<!-- =========================\n     PHOTOGRAPHIE S23\n========================= -->\n<section class=\"photo-page page\">\n<img src=\"images/c-klein-23-monolithe-nuit-lune.jpg\"\nalt=\"Le monolithe - Nuit avec lune - Odyssée, Charles Klein\"\n>\n<div\n    class=\"caption\"\n    data-fr=\"Le monolithe\"\n    data-en=\"The monolith\">\n </div>\n</section>\n\n<!-- =========================\n     PAGE DE FIN\n========================= -->\n::: {.text-page .page}\n::: {.lang-fr}\n::: {.text-content}\n### Charles Klein — Tous droits réservés\n[charlesklein.photos](https://charlesklein.photos/fr/accueil){target=\"_blank\"}\n\n:::\n:::\n\n::: {.lang-en}\n::: {.text-content}\n### Charles Klein — All rights reserved\n[charlesklein.photos](https://charlesklein.photos/en/home){target=\"_blank\"}\n\n:::\n:::\n:::\n\n<!-- =========================\n     FIN DU LIVRE\n========================= -->\n</div>\n\n<!-- Compteur -->\n\n<div id=\"page-counter\"></div>\n\n<!-- Zones de navigation -->\n\n<div class=\"nav-left\"></div>\n\n<div class=\"nav-right\"></div>"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipy